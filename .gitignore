# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase. Neither of these is in the repo, for two different reasons.
#
# The service account key is a real credential — it is what lets Expo's push
# service send through FCM. It lives in EAS (npx eas credentials -p android).
#
# google-services.json is NOT a secret (Google documents Firebase API keys as
# safe to ship, and it is extractable from any APK), but this repo is public and
# a fork has no business inheriting this project's Firebase identity. EAS gets it
# as a file-type env var instead — see app.config.js.
*-firebase-adminsdk-*.json
google-service-account*.json
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# per-profile real credentials (see env-profiles/*.env.example)
env-profiles/*.env
!env-profiles/*.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Supabase stack state (supabase start / db reset). Machine-local — the
# migrations are the shared artifact, this is just the container's bookkeeping.
supabase/.branches/
supabase/.temp/
