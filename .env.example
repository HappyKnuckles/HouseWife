# ---------------------------------------------------------------------------
# Expo app — copy to .env and fill in.
#
# Only EXPO_PUBLIC_* variables are readable from app code, and they are BAKED
# INTO THE BUNDLE. Never put the service_role key here; it belongs in Supabase
# secrets (see below) and nowhere else.
#
# Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required by expo-notifications to mint a push token. It is your EAS project
# id, shown by `eas init` and in app.json under extra.eas.projectId.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000


# ---------------------------------------------------------------------------
# The two household members do NOT go in this file. There is no sign-up
# screen — the app is built for exactly two fixed accounts, and the sign-in
# screen is just a "who are you" picker between them — but which two people
# depends on dev vs. prod, so that pair lives in env-profiles/ instead:
#
#   env-profiles/prod.env.example   → the real household
#   env-profiles/dev.env.example    → throwaway test1/test2, own household
#
# Copy whichever(s) you need (drop the .example), then activate one:
#   npm run env:dev   # or: npm run env:prod
#
# That writes .env.local (git-ignored, always merged on top of this file),
# which is what actually supplies EXPO_PUBLIC_USER_A/B_* at runtime. Then:
#   npm run seed:users
# creates those two accounts in Supabase if they don't exist yet — see the
# comment at the top of supabase/scripts/create-users.mjs.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Edge Function secrets — NOT part of this file's job.
#
# Set these on the server, they are never bundled into the app:
#
#   supabase secrets set CRON_SECRET="$(openssl rand -hex 32)"
#
#   # optional, off by default:
#   supabase secrets set BARCODE_PROVIDERS=openfoodfacts
#   supabase secrets set OCR_PROVIDER=noop
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into functions automatically — do not set them yourself.
#
# CRON_SECRET must match the value in supabase/cron/schedule.sql.
# ---------------------------------------------------------------------------
