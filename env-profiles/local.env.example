# The local Supabase stack (Docker) — a throwaway database on your own machine.
#
# This is the profile to use when a migration is not on the real project yet:
# `supabase start` applies every file in supabase/migrations/ to a fresh local
# Postgres, so you can run the app against the new schema without touching the
# shared project. Note that dev.env and prod.env do NOT differ in that respect —
# they point at the same Supabase project and only swap which two users sign in.
#
#   npm run db:local      # start the stack + apply migrations + seed the users
#   npm run env:local     # point the app at it
#   npm start             # (or npx expo start --clear)
#
# Copy this file to local.env (git-ignored) to use it as-is; the placeholders
# below work fine — these accounts only exist inside your own container.
#
# EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are deliberately NOT listed here: switch-env.mjs
# reads them from `supabase status` when you select this profile, so they
# always match the running container instead of a stale copy in a file.
HOUSEHOLD_NAME=Lokaler Testhaushalt

EXPO_PUBLIC_USER_A_NAME=local1
EXPO_PUBLIC_USER_A_EMAIL=local1@haushalt.local
EXPO_PUBLIC_USER_A_PASSWORD=local1234

EXPO_PUBLIC_USER_B_NAME=local2
EXPO_PUBLIC_USER_B_EMAIL=local2@haushalt.local
EXPO_PUBLIC_USER_B_PASSWORD=local1234
