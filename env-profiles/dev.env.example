# Throwaway accounts for local development/testing. They get their own
# household ("Testhaushalt") — RLS fully isolates it from the real one, so
# nothing you do here can touch or corrupt real household data, even though
# it's the same Supabase project. Copy this file to dev.env (git-ignored) to
# use it as-is; the placeholder values below work fine for that.
#
# Activate it with: npm run env:dev
HOUSEHOLD_NAME=Testhaushalt

EXPO_PUBLIC_USER_A_NAME=test1
EXPO_PUBLIC_USER_A_EMAIL=test1@haushalt.local
EXPO_PUBLIC_USER_A_PASSWORD=test1234

EXPO_PUBLIC_USER_B_NAME=test2
EXPO_PUBLIC_USER_B_EMAIL=test2@haushalt.local
EXPO_PUBLIC_USER_B_PASSWORD=test1234
