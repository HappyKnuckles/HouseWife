# The real household. Copy this file to prod.env (git-ignored, only this
# .example is tracked) and fill in your actual names/passwords.
#
# The names are what the sign-in screen shows on the two cards; the addresses
# never receive mail, so anything that parses is fine.
#
# Activate it with: npm run env:prod
HOUSEHOLD_NAME=Zuhause

EXPO_PUBLIC_USER_A_NAME=Ich
EXPO_PUBLIC_USER_A_EMAIL=a@haushalt.local
EXPO_PUBLIC_USER_A_PASSWORD=change-me-a

EXPO_PUBLIC_USER_B_NAME=Partner:in
EXPO_PUBLIC_USER_B_EMAIL=b@haushalt.local
EXPO_PUBLIC_USER_B_PASSWORD=change-me-b
